<#@ template language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
@page "/<#= model.ClassName #>"
@inherits BaseWeb<<#= model.ClassName #>>

@rendermode InteractiveServer

<h3><#= model.ClassName #>Grid</h3>

<USS_Grid @bind-Values="Datas" 
          IsAction="true" 
          IdVisible="false"
          OnAdd="@( x => { Add(); })" 
          OnCancel="@( (BaseGridModel<<#= model.ClassName #>> x) => { Cancel(x); })"
          OnEdit="@( (BaseGridModel<<#= model.ClassName #>> x) => { Edit(x); })"
          OnSave="@( (BaseGridModel<<#= model.ClassName #>> x) => { Save(x); })"
          OnDelete="@( (BaseGridModel<<#= model.ClassName #>> x) => { Delete(x); })"
          OnDeleteClose="@( ( string x)=>{ OnDeleteClose(x);})" />