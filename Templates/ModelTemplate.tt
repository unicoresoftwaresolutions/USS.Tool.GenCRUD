<#@ template language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>


using USS.Base.Model;

namespace <#= model.Namespace #>
{
    public partial class <#= model.ClassName #> : BaseEntityModel
    {

    <# foreach(var field in model.Fields) { #>
    public <#= field.DataType #> <#= field.Name #> { get; set; }
    <# } #>

    <# foreach(var field in model.References) { #>
    public <#= field.Reference.TableName#> <#= field.Reference.TableName#> { get; set; }
    <# } #>

    <# foreach(var table in model.LookUpTables) { #>
    public List<<#= table.TableName#>>? <#= table.TableName#>s { get; set; }
    <# } #>

    }
}
