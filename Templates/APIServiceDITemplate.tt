<#@ template language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>


using <#= RootNamespace #>.Business;
using <#= RootNamespace #>.Business.Interface;
using <#= RootNamespace #>.Data;
using <#= RootNamespace #>.Data.Interface;

namespace <#= RootNamespace #>.ApiService
{
    public static class ServiceDI
    {
        public static void AddServiceDI(this IServiceCollection services)
        {

            <#
                foreach (var model in models)
                {
                    var className = model.ClassName;
            #>

            services.AddScoped<I<#= className #>Data, <#= className #>Data>();
            services.AddScoped<I<#= className #>Business, <#= className #>Business>();
            <#
                }
            #>

        }
    }
}
